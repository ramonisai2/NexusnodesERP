# Local development defaults (never use in production)
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_erp?sslmode=disable
REDIS_URL=redis://localhost:6379/0
OPA_URL=http://localhost:8181
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=nexus
KEYCLOAK_CLIENT_ID=nexus-spa
JWT_ISSUER=http://localhost:8081/realms/nexus
JWT_AUDIENCE=nexus-api
JWT_JWKS_URL=http://localhost:8081/realms/nexus/protocol/openid-connect/certs
GATEWAY_ADDR=:8080
INVENTORY_ADDR=:8082
PAYROLL_ADDR=:8083
REPORTING_ADDR=:8084
REPORTS_ADDR=:8085
SEARCH_ADDR=:8086
MESSAGING_ADDR=:8087
INVENTORY_URL=http://localhost:8082
PAYROLL_URL=http://localhost:8083
REPORTING_URL=http://localhost:8084
REPORTS_URL=http://localhost:8085
SEARCH_URL=http://localhost:8086
MESSAGING_URL=http://localhost:8087
SEARCH_REINDEX_SECONDS=30
IMAGE_STORAGE_PATH=./data/image-reports
IMAGE_MAX_EDGE=1280
IMAGE_JPEG_QUALITY=82
IMAGE_MAX_UPLOAD_BYTES=12582912
PUBLIC_WEB_BASE=http://localhost:5173
# Optional kill switch: NETWORK_MODE_FORCE=intranet disables public storefront/customer routes process-wide
# NETWORK_MODE_FORCE=intranet
IMAGE_UPLOAD_SESSION_TTL_MIN=20
# Dev-only HMAC secret used when Keycloak is unavailable (HS256 fallback)
DEV_JWT_SECRET=nexus-dev-secret-change-me
DEV_AUTH_BYPASS=true
NATS_URL=nats://127.0.0.1:4222
NATS_SUBJECT_PREFIX=nexus.events
OUTBOX_POLL_INTERVAL=1s
SMTP_ENABLED=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=nexus@demo.local
NOTIFY_EMAIL_TO=ops@demo.nexus,analyst@demo.nexus
OTEL_EXPORTER=none
# OTEL_EXPORTER=otlp
# Point at Tempo OTLP/HTTP (:4318) or otel-collector host port (:4319)
# OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4318
# SERVICE_VERSION=0.1.0
# Grafana (obs profile): http://localhost:3000  admin/admin
# Tempo query API: http://localhost:3200
