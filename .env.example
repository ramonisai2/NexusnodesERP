# Local development defaults (never use in production)
DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_erp?sslmode=disable
REDIS_URL=redis://localhost:6379/0
OPA_URL=http://localhost:8181
KEYCLOAK_URL=http://localhost:8081
KEYCLOAK_REALM=nexus
KEYCLOAK_CLIENT_ID=nexus-spa
JWT_ISSUER=http://localhost:8081/realms/nexus
JWT_AUDIENCE=nexus-api
JWT_JWKS_URL=http://localhost:8081/realms/nexus/protocol/openid-connect/certs
GATEWAY_ADDR=:8080
INVENTORY_ADDR=:8082
PAYROLL_ADDR=:8083
INVENTORY_URL=http://localhost:8082
PAYROLL_URL=http://localhost:8083
# Dev-only HMAC secret used when Keycloak is unavailable (HS256 fallback)
DEV_JWT_SECRET=nexus-dev-secret-change-me
DEV_AUTH_BYPASS=true
NATS_URL=nats://127.0.0.1:4222
NATS_SUBJECT_PREFIX=nexus.events
OUTBOX_POLL_INTERVAL=1s
