    {
      "title": "Pipeline de eventos",
      "type": "text",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "Flujo: **acción HTTP** → outbox → `outbox-relay` (`outbox.publishBatch`) → NATS → `notification` (`notification.handle`) → SMTP/Mailhog.\n\nCon propagación W3C, una misma `trace_id` puede unir relay + notification."
      }
    },
    {
      "title": "Outbox relay — publishBatch",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 11, "w": 12, "x": 0, "y": 3 },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "refId": "A",
          "query": "{ resource.service.name = \"outbox-relay\" && name = \"outbox.publishBatch\" }",
          "limit": 25
        }
      ]
    },
    {
      "title": "Notification — handle",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 11, "w": 12, "x": 12, "y": 3 },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "refId": "A",
          "query": "{ resource.service.name = \"notification\" && name = \"notification.handle\" }",
          "limit": 25
        }
      ]
    },
    {
      "title": "Reporting BFF (GraphQL)",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 14 },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "refId": "A",
          "query": "{ resource.service.name = \"reporting-bff\" }",
          "limit": 20
        }
      ]
    },
    {
      "title": "HTTP lentos (>500ms)",
      "type": "traces",
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 14 },
      "targets": [
        {
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "refId": "A",
          "query": "{ duration > 500ms && resource.service.name =~ \".+\" }",
          "limit": 20
        }
      ]
